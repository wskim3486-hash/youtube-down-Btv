{
  "name": "company-media-downloader",
  "version": "0.1.0",
  "description": "Windows와 macOS용 사내 공개 영상 다운로드 데스크톱 앱",
  "productName": "Btv ClipPort",
  "author": "wskim0131@sk.com",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "tools:prepare": "node scripts/prepare-tools.mjs",
    "desktop": "npm run tools:prepare && node scripts/run-electron.mjs",
    "desktop:smoke": "npm run tools:prepare && node scripts/run-electron.mjs --smoke-test",
    "dist:win": "npm run tools:prepare && electron-builder --win nsis",
    "dist:mac": "npm run tools:prepare && node scripts/build-mac.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  }
}
